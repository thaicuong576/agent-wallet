{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-wallet:contracts:ips",
  "title": "IPS",
  "description": "Investment Policy Statement, set by the wallet owner out of band. Read-only for the agent: no API writes it. Its revision is identified by its hash (ips_hash), not by a counter. Threshold values in examples are illustrative, not recommendations.",
  "type": "object",
  "required": [
    "schema_version",
    "owner",
    "objective",
    "universe",
    "allocation",
    "risk",
    "limits",
    "approval"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "owner": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "description": "Owner wallet address. The only address in any contract object other than tx hashes."
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "universe": {
      "type": "object",
      "required": [
        "tokens",
        "protocols",
        "functions",
        "recipients"
      ],
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Token"
          }
        },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Protocol"
          }
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Function"
          }
        },
        "recipients": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Recipient"
          }
        }
      }
    },
    "allocation": {
      "type": "object",
      "required": [
        "max_weight_per_asset_bps",
        "min_stable_weight_bps",
        "rebalance_band_bps"
      ],
      "additionalProperties": false,
      "properties": {
        "max_weight_per_asset_bps": {
          "$ref": "#/$defs/Bps"
        },
        "min_stable_weight_bps": {
          "$ref": "#/$defs/Bps"
        },
        "rebalance_band_bps": {
          "$ref": "#/$defs/Bps"
        }
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "min_pool_tvl_usd",
        "max_depeg_bps",
        "max_slippage_bps",
        "max_reward_apy_share_bps",
        "max_apy_deviation_bps",
        "max_utilization_bps",
        "min_benefit_cost_ratio_bps",
        "max_data_age_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "min_pool_tvl_usd": {
          "$ref": "#/$defs/UsdString"
        },
        "max_depeg_bps": {
          "$ref": "#/$defs/Bps"
        },
        "max_slippage_bps": {
          "$ref": "#/$defs/Bps"
        },
        "max_reward_apy_share_bps": {
          "$ref": "#/$defs/Bps"
        },
        "max_apy_deviation_bps": {
          "type": "integer",
          "minimum": 0,
          "description": "Not in the sample IPS; needed by RISK.APY_UNSTABLE (draft section 7)."
        },
        "max_utilization_bps": {
          "$ref": "#/$defs/Bps",
          "description": "Not in the sample IPS; needed by RISK.UTILIZATION_TOO_HIGH (draft section 7)."
        },
        "min_benefit_cost_ratio_bps": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum benefit to cost ratio in basis points (20000 = 2x). Not in the sample IPS; needed by RISK.COST_EXCEEDS_BENEFIT."
        },
        "max_data_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Not in the sample IPS; needed by RISK.DATA_STALE (draft section 14)."
        }
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "per_tx_usd",
        "per_day_usd",
        "max_tx_per_hour"
      ],
      "additionalProperties": false,
      "properties": {
        "per_tx_usd": {
          "$ref": "#/$defs/UsdString"
        },
        "per_day_usd": {
          "$ref": "#/$defs/UsdString"
        },
        "max_tx_per_hour": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "escalate_above_usd"
      ],
      "additionalProperties": false,
      "properties": {
        "escalate_above_usd": {
          "$ref": "#/$defs/UsdString",
          "description": "Orders worth more than this wait for owner approval (rule TIER.APPROVAL_REQUIRED)."
        }
      }
    }
  },
  "$defs": {
    "Bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "Ratio in basis points (10000 = 100%)."
    },
    "Function": {
      "type": "string",
      "enum": [
        "approve",
        "supply",
        "withdraw",
        "exactInputSingle"
      ]
    },
    "Protocol": {
      "type": "string",
      "enum": [
        "aave-v3",
        "uniswap-v3"
      ]
    },
    "Recipient": {
      "type": "string",
      "enum": [
        "self",
        "aave_pool",
        "uniswap_router"
      ]
    },
    "SchemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Version of this contract object. Bump only through the versioning rule in contracts/README.md."
    },
    "Token": {
      "type": "string",
      "enum": [
        "USDC",
        "WETH"
      ]
    },
    "UsdString": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,6})?$",
      "description": "Non-negative USD value as a decimal string. Never a float."
    }
  }
}
