{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-wallet:contracts:order",
  "title": "Order",
  "description": "A proposed on-chain action. Contains enum values and amounts only: never an address, never free text.",
  "type": "object",
  "required": [
    "schema_version",
    "order_id",
    "created_at",
    "proposed_by",
    "protocol",
    "function",
    "token",
    "amount",
    "recipient"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "order_id": {
      "$ref": "#/$defs/Uuid"
    },
    "created_at": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "proposed_by": {
      "type": "string",
      "enum": [
        "planner",
        "owner",
        "eval"
      ]
    },
    "protocol": {
      "$ref": "#/$defs/Protocol"
    },
    "function": {
      "$ref": "#/$defs/Function"
    },
    "token": {
      "$ref": "#/$defs/Token"
    },
    "amount": {
      "$ref": "#/$defs/PositiveAmount"
    },
    "token_out": {
      "$ref": "#/$defs/Token",
      "description": "Only for exactInputSingle: the token received."
    },
    "max_slippage_bps": {
      "$ref": "#/$defs/Bps",
      "description": "Only for exactInputSingle: slippage ceiling for the swap."
    },
    "recipient": {
      "$ref": "#/$defs/Recipient",
      "description": "Who receives the effect: the spender for approve, self for supply, withdraw and swap output."
    },
    "market": {
      "$ref": "#/$defs/Market",
      "description": "Only for morpho-blue: which market. Never an address or a market id."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "function": {
            "const": "exactInputSingle"
          }
        },
        "required": [
          "function"
        ]
      },
      "then": {
        "required": [
          "token_out",
          "max_slippage_bps"
        ]
      },
      "else": {
        "properties": {
          "token_out": false,
          "max_slippage_bps": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "token": {
            "const": "USDC"
          }
        },
        "required": [
          "token"
        ]
      },
      "then": {
        "properties": {
          "amount": {
            "properties": {
              "decimals": {
                "const": 6
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "token": {
            "const": "WETH"
          }
        },
        "required": [
          "token"
        ]
      },
      "then": {
        "properties": {
          "amount": {
            "properties": {
              "decimals": {
                "const": 18
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "token": {
            "const": "ETH"
          }
        },
        "required": [
          "token"
        ]
      },
      "then": {
        "properties": {
          "amount": {
            "properties": {
              "decimals": {
                "const": 18
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "function": {
            "const": "mint"
          }
        },
        "required": [
          "function"
        ]
      },
      "then": {
        "properties": {
          "token": {
            "enum": [
              "USDC",
              "USDT"
            ]
          },
          "recipient": {
            "const": "self"
          },
          "protocol": {
            "const": "aave-v3"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "function": {
            "const": "transfer"
          }
        },
        "required": [
          "function"
        ]
      },
      "then": {
        "properties": {
          "recipient": {
            "const": "owner"
          },
          "protocol": {
            "const": "wallet"
          },
          "token": {
            "enum": [
              "USDC",
              "ETH"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "recipient": {
            "const": "owner"
          }
        },
        "required": [
          "recipient"
        ]
      },
      "then": {
        "properties": {
          "function": {
            "const": "transfer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "token": {
            "const": "USDT"
          }
        },
        "required": [
          "token"
        ]
      },
      "then": {
        "properties": {
          "amount": {
            "properties": {
              "decimals": {
                "const": 6
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "token": {
            "const": "WBTC"
          }
        },
        "required": [
          "token"
        ]
      },
      "then": {
        "properties": {
          "amount": {
            "properties": {
              "decimals": {
                "const": 8
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "token": {
            "const": "cbETH"
          }
        },
        "required": [
          "token"
        ]
      },
      "then": {
        "properties": {
          "amount": {
            "properties": {
              "decimals": {
                "const": 18
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "token": {
            "const": "LINK"
          }
        },
        "required": [
          "token"
        ]
      },
      "then": {
        "properties": {
          "amount": {
            "properties": {
              "decimals": {
                "const": 18
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "token": {
            "const": "USDbC"
          }
        },
        "required": [
          "token"
        ]
      },
      "then": {
        "properties": {
          "amount": {
            "properties": {
              "decimals": {
                "const": 6
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "market"
        ]
      },
      "then": {
        "properties": {
          "protocol": {
            "const": "morpho-blue"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protocol": {
            "const": "aave-stata"
          }
        },
        "required": [
          "protocol"
        ]
      },
      "then": {
        "properties": {
          "token": {
            "enum": [
              "USDC",
              "USDT"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "Bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "Ratio in basis points (10000 = 100%)."
    },
    "Function": {
      "type": "string",
      "enum": [
        "approve",
        "supply",
        "withdraw",
        "exactInputSingle",
        "mint",
        "transfer"
      ]
    },
    "PositiveAmount": {
      "type": "object",
      "description": "Token amount as an integer string in the smallest unit plus decimals. Never a float. At most 30 digits, so a max-uint256 'unlimited' amount cannot be represented.",
      "required": [
        "value",
        "decimals"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,29}$"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        }
      }
    },
    "Protocol": {
      "type": "string",
      "enum": [
        "aave-v3",
        "uniswap-v3",
        "wallet",
        "morpho-blue",
        "moonwell",
        "aave-stata"
      ]
    },
    "Recipient": {
      "type": "string",
      "enum": [
        "self",
        "aave_pool",
        "uniswap_router",
        "owner"
      ]
    },
    "SchemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Version of this contract object. Bump only through the versioning rule in contracts/README.md."
    },
    "Token": {
      "type": "string",
      "enum": [
        "USDC",
        "WETH",
        "ETH",
        "USDT",
        "WBTC",
        "cbETH",
        "LINK",
        "USDbC"
      ]
    },
    "UtcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "description": "RFC 3339 timestamp, always UTC with a trailing Z."
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID, generated by the client."
    },
    "Market": {
      "type": "string",
      "enum": [
        "usdc-wbtc",
        "usdc-cbeth"
      ],
      "description": "Morpho Blue market, chosen from a fixed list. The market id lives in code, never in an order."
    }
  }
}
