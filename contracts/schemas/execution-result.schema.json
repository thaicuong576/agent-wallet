{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-wallet:contracts:execution-result",
  "title": "ExecutionResult",
  "description": "Result of the gateway executing an allowed order. detail must never contain a key, a seed phrase or a full request body.",
  "type": "object",
  "required": [
    "schema_version",
    "order_id",
    "status",
    "tx_hash",
    "chain_id",
    "block_number",
    "gas_used",
    "error_code",
    "detail",
    "executed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "order_id": {
      "$ref": "#/$defs/Uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "executed",
        "failed"
      ]
    },
    "tx_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/TxHash"
        },
        {
          "type": "null"
        }
      ]
    },
    "chain_id": {
      "type": "integer",
      "const": 84532,
      "description": "Base Sepolia only."
    },
    "block_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "gas_used": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "SIMULATION_FAILED",
        "BALANCE_DELTA_UNEXPECTED",
        "TX_REVERTED",
        "SIGNER_UNAVAILABLE",
        null
      ]
    },
    "detail": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500,
      "description": "Human-readable failure detail. Never a key, a seed phrase or a full request body."
    },
    "executed_at": {
      "$ref": "#/$defs/UtcTimestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "executed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "tx_hash": {
            "type": "string"
          },
          "error_code": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "error_code": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$defs": {
    "SchemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Version of this contract object. Bump only through the versioning rule in contracts/README.md."
    },
    "TxHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "UtcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "description": "RFC 3339 timestamp, always UTC with a trailing Z."
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID, generated by the client."
    }
  }
}
