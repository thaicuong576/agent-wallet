{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-wallet:contracts:decision-record",
  "title": "DecisionRecord",
  "description": "One append-only audit record. seq is assigned by the log, never by the caller. hash is SHA-256 over the canonical JSON of this record without its hash field (so it includes prev_hash). The first prev_hash is 64 zeros.",
  "type": "object",
  "required": [
    "schema_version",
    "seq",
    "order_id",
    "order",
    "decision",
    "no_action",
    "outcome",
    "execution",
    "approval",
    "tier",
    "emergency_stop",
    "ips_hash",
    "created_at",
    "prev_hash",
    "hash"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "order_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null only when outcome is no_action."
    },
    "order": {
      "anyOf": [
        {
          "$ref": "#/$defs/Order"
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/Decision"
        },
        {
          "type": "null"
        }
      ]
    },
    "no_action": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "rules_hit",
            "reason"
          ],
          "additionalProperties": false,
          "properties": {
            "rules_hit": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/RuleHit"
              },
              "maxItems": 32
            },
            "reason": {
              "$ref": "#/$defs/Reason"
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "Why nothing was done (in band, emergency stop engaged or released). Present only when outcome is no_action."
    },
    "outcome": {
      "type": "string",
      "enum": [
        "no_action",
        "denied",
        "pending_approval",
        "executed",
        "failed"
      ]
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionResult"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/Approval"
        },
        {
          "type": "null"
        }
      ]
    },
    "tier": {
      "$ref": "#/$defs/Tier"
    },
    "emergency_stop": {
      "type": "boolean"
    },
    "ips_hash": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "created_at": {
      "$ref": "#/$defs/UtcTimestamp"
    },
    "prev_hash": {
      "$ref": "#/$defs/Sha256Hex"
    },
    "hash": {
      "$ref": "#/$defs/Sha256Hex"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "no_action"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "order_id": {
            "type": "null"
          },
          "order": {
            "type": "null"
          },
          "decision": {
            "type": "null"
          },
          "execution": {
            "type": "null"
          },
          "approval": {
            "type": "null"
          },
          "no_action": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "order_id": {
            "type": "string"
          },
          "order": {
            "type": "object"
          },
          "decision": {
            "type": "object"
          },
          "no_action": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "pending_approval"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "decision": {
                "const": "escalate"
              }
            }
          },
          "execution": {
            "type": "null"
          },
          "approval": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "denied"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "decision": {
                "const": "deny"
              }
            }
          },
          "execution": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "executed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "type": "object",
            "properties": {
              "status": {
                "const": "executed"
              }
            },
            "required": [
              "status"
            ]
          },
          "decision": {
            "properties": {
              "decision": {
                "enum": [
                  "allow",
                  "escalate"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "failed"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "execution": {
            "type": "object",
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "decision": {
            "properties": {
              "decision": {
                "enum": [
                  "allow",
                  "escalate"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "executed",
              "failed"
            ]
          },
          "decision": {
            "type": "object",
            "properties": {
              "decision": {
                "const": "escalate"
              }
            },
            "required": [
              "decision"
            ]
          }
        },
        "required": [
          "outcome",
          "decision"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "type": "object",
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval": {
            "type": "object",
            "properties": {
              "status": {
                "const": "rejected"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "approval"
        ]
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "denied"
          }
        }
      }
    }
  ],
  "$defs": {
    "Approval": {
      "title": "Approval",
      "description": "The owner's answer to a pending order. Only the owner can approve or reject.",
      "type": "object",
      "required": [
        "status",
        "by",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "by": {
          "type": "string",
          "const": "owner"
        },
        "at": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      }
    },
    "Bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "Ratio in basis points (10000 = 100%)."
    },
    "Decision": {
      "title": "Decision",
      "description": "Policy engine result for one order. Separate from Outcome (the final status).",
      "type": "object",
      "required": [
        "schema_version",
        "order_id",
        "decision",
        "rules_hit",
        "reason",
        "ips_hash",
        "decided_at"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "order_id": {
          "$ref": "#/$defs/Uuid"
        },
        "decision": {
          "type": "string",
          "enum": [
            "allow",
            "deny",
            "escalate"
          ]
        },
        "rules_hit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleHit"
          },
          "maxItems": 32,
          "description": "Rules that fired, each with its evidence. May be empty for allow."
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        },
        "ips_hash": {
          "$ref": "#/$defs/Sha256Hex",
          "description": "SHA-256 of the canonical JSON of the IPS this decision was evaluated under."
        },
        "decided_at": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      }
    },
    "ExecutionResult": {
      "title": "ExecutionResult",
      "description": "Result of the gateway executing an allowed order. detail must never contain a key, a seed phrase or a full request body.",
      "type": "object",
      "required": [
        "schema_version",
        "order_id",
        "status",
        "tx_hash",
        "chain_id",
        "block_number",
        "gas_used",
        "error_code",
        "detail",
        "executed_at"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "order_id": {
          "$ref": "#/$defs/Uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "executed",
            "failed"
          ]
        },
        "tx_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/TxHash"
            },
            {
              "type": "null"
            }
          ]
        },
        "chain_id": {
          "type": "integer",
          "const": 84532,
          "description": "Base Sepolia only."
        },
        "block_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "gas_used": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "SIMULATION_FAILED",
            "BALANCE_DELTA_UNEXPECTED",
            "TX_REVERTED",
            "SIGNER_UNAVAILABLE",
            null
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "Human-readable failure detail. Never a key, a seed phrase or a full request body."
        },
        "executed_at": {
          "$ref": "#/$defs/UtcTimestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "executed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "tx_hash": {
                "type": "string"
              },
              "error_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "error_code": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "Function": {
      "type": "string",
      "enum": [
        "approve",
        "supply",
        "withdraw",
        "exactInputSingle",
        "mint",
        "transfer"
      ]
    },
    "Market": {
      "type": "string",
      "enum": [
        "usdc-wbtc",
        "usdc-cbeth"
      ],
      "description": "Morpho Blue market, chosen from a fixed list. The market id lives in code, never in an order."
    },
    "Order": {
      "title": "Order",
      "description": "A proposed on-chain action. Contains enum values and amounts only: never an address, never free text.",
      "type": "object",
      "required": [
        "schema_version",
        "order_id",
        "created_at",
        "proposed_by",
        "protocol",
        "function",
        "token",
        "amount",
        "recipient"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "order_id": {
          "$ref": "#/$defs/Uuid"
        },
        "created_at": {
          "$ref": "#/$defs/UtcTimestamp"
        },
        "proposed_by": {
          "type": "string",
          "enum": [
            "planner",
            "owner",
            "eval"
          ]
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "function": {
          "$ref": "#/$defs/Function"
        },
        "token": {
          "$ref": "#/$defs/Token"
        },
        "amount": {
          "$ref": "#/$defs/PositiveAmount"
        },
        "token_out": {
          "$ref": "#/$defs/Token",
          "description": "Only for exactInputSingle: the token received."
        },
        "max_slippage_bps": {
          "$ref": "#/$defs/Bps",
          "description": "Only for exactInputSingle: slippage ceiling for the swap."
        },
        "recipient": {
          "$ref": "#/$defs/Recipient",
          "description": "Who receives the effect: the spender for approve, self for supply, withdraw and swap output."
        },
        "market": {
          "$ref": "#/$defs/Market",
          "description": "Only for morpho-blue: which market. Never an address or a market id."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "function": {
                "const": "exactInputSingle"
              }
            },
            "required": [
              "function"
            ]
          },
          "then": {
            "required": [
              "token_out",
              "max_slippage_bps"
            ]
          },
          "else": {
            "properties": {
              "token_out": false,
              "max_slippage_bps": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "token": {
                "const": "USDC"
              }
            },
            "required": [
              "token"
            ]
          },
          "then": {
            "properties": {
              "amount": {
                "properties": {
                  "decimals": {
                    "const": 6
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "token": {
                "const": "WETH"
              }
            },
            "required": [
              "token"
            ]
          },
          "then": {
            "properties": {
              "amount": {
                "properties": {
                  "decimals": {
                    "const": 18
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "token": {
                "const": "ETH"
              }
            },
            "required": [
              "token"
            ]
          },
          "then": {
            "properties": {
              "amount": {
                "properties": {
                  "decimals": {
                    "const": 18
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "function": {
                "const": "mint"
              }
            },
            "required": [
              "function"
            ]
          },
          "then": {
            "properties": {
              "token": {
                "enum": [
                  "USDC",
                  "USDT"
                ]
              },
              "recipient": {
                "const": "self"
              },
              "protocol": {
                "const": "aave-v3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "function": {
                "const": "transfer"
              }
            },
            "required": [
              "function"
            ]
          },
          "then": {
            "properties": {
              "recipient": {
                "const": "owner"
              },
              "protocol": {
                "const": "wallet"
              },
              "token": {
                "enum": [
                  "USDC",
                  "ETH"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "recipient": {
                "const": "owner"
              }
            },
            "required": [
              "recipient"
            ]
          },
          "then": {
            "properties": {
              "function": {
                "const": "transfer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "token": {
                "const": "USDT"
              }
            },
            "required": [
              "token"
            ]
          },
          "then": {
            "properties": {
              "amount": {
                "properties": {
                  "decimals": {
                    "const": 6
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "token": {
                "const": "WBTC"
              }
            },
            "required": [
              "token"
            ]
          },
          "then": {
            "properties": {
              "amount": {
                "properties": {
                  "decimals": {
                    "const": 8
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "token": {
                "const": "cbETH"
              }
            },
            "required": [
              "token"
            ]
          },
          "then": {
            "properties": {
              "amount": {
                "properties": {
                  "decimals": {
                    "const": 18
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "token": {
                "const": "LINK"
              }
            },
            "required": [
              "token"
            ]
          },
          "then": {
            "properties": {
              "amount": {
                "properties": {
                  "decimals": {
                    "const": 18
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "token": {
                "const": "USDbC"
              }
            },
            "required": [
              "token"
            ]
          },
          "then": {
            "properties": {
              "amount": {
                "properties": {
                  "decimals": {
                    "const": 6
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "market"
            ]
          },
          "then": {
            "properties": {
              "protocol": {
                "const": "morpho-blue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "aave-stata"
              }
            },
            "required": [
              "protocol"
            ]
          },
          "then": {
            "properties": {
              "token": {
                "enum": [
                  "USDC",
                  "USDT"
                ]
              }
            }
          }
        }
      ]
    },
    "PositiveAmount": {
      "type": "object",
      "description": "Token amount as an integer string in the smallest unit plus decimals. Never a float. At most 30 digits, so a max-uint256 'unlimited' amount cannot be represented.",
      "required": [
        "value",
        "decimals"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,29}$"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        }
      }
    },
    "Protocol": {
      "type": "string",
      "enum": [
        "aave-v3",
        "uniswap-v3",
        "wallet",
        "morpho-blue",
        "moonwell",
        "aave-stata"
      ]
    },
    "Reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Human-readable reason, generated by code from the rules hit and their evidence."
    },
    "Recipient": {
      "type": "string",
      "enum": [
        "self",
        "aave_pool",
        "uniswap_router",
        "owner"
      ]
    },
    "RuleCode": {
      "type": "string",
      "pattern": "^[A-Z]+\\.[A-Z0-9_]+$",
      "description": "Stable rule code listed in contracts/rule-codes.json, for example LIMIT.PER_TX."
    },
    "RuleHit": {
      "type": "object",
      "required": [
        "code",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/RuleCode"
        },
        "evidence": {
          "type": "object",
          "description": "Flat key to value facts that triggered the rule. Strings, integers and booleans only; no floats, no nesting.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ],
            "maxLength": 200
          }
        }
      }
    },
    "SchemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Version of this contract object. Bump only through the versioning rule in contracts/README.md."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Tier": {
      "type": "string",
      "enum": [
        "T0",
        "T1",
        "T2"
      ],
      "description": "T0 read-only, T1 propose-only with user signing (reserved: no v1 code path uses it), T2 bounded autonomy. Approval above a threshold is the rule TIER.APPROVAL_REQUIRED, not a tier."
    },
    "Token": {
      "type": "string",
      "enum": [
        "USDC",
        "WETH",
        "ETH",
        "USDT",
        "WBTC",
        "cbETH",
        "LINK",
        "USDbC"
      ]
    },
    "TxHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "UtcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "description": "RFC 3339 timestamp, always UTC with a trailing Z."
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID, generated by the client."
    }
  }
}
