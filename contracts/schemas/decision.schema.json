{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-wallet:contracts:decision",
  "title": "Decision",
  "description": "Policy engine result for one order. Separate from Outcome (the final status).",
  "type": "object",
  "required": [
    "schema_version",
    "order_id",
    "decision",
    "rules_hit",
    "reason",
    "ips_hash",
    "decided_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "order_id": {
      "$ref": "#/$defs/Uuid"
    },
    "decision": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "escalate"
      ]
    },
    "rules_hit": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RuleHit"
      },
      "maxItems": 32,
      "description": "Rules that fired, each with its evidence. May be empty for allow."
    },
    "reason": {
      "$ref": "#/$defs/Reason"
    },
    "ips_hash": {
      "$ref": "#/$defs/Sha256Hex",
      "description": "SHA-256 of the canonical JSON of the IPS this decision was evaluated under."
    },
    "decided_at": {
      "$ref": "#/$defs/UtcTimestamp"
    }
  },
  "$defs": {
    "Reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Human-readable reason, generated by code from the rules hit and their evidence."
    },
    "RuleCode": {
      "type": "string",
      "pattern": "^[A-Z]+\\.[A-Z0-9_]+$",
      "description": "Stable rule code listed in contracts/rule-codes.json, for example LIMIT.PER_TX."
    },
    "RuleHit": {
      "type": "object",
      "required": [
        "code",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/RuleCode"
        },
        "evidence": {
          "type": "object",
          "description": "Flat key to value facts that triggered the rule. Strings, integers and booleans only; no floats, no nesting.",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ],
            "maxLength": 200
          }
        }
      }
    },
    "SchemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Version of this contract object. Bump only through the versioning rule in contracts/README.md."
    },
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "UtcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "description": "RFC 3339 timestamp, always UTC with a trailing Z."
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID, generated by the client."
    }
  }
}
