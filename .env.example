# Copy to .env and fill in. Never commit .env. Testnet only, never a mainnet key.
OPENAI_API_KEY=
AGENT_WALLET_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
IPS_PATH=contracts/examples/ips.valid.json
AGENT_WALLET_RISK_SOURCE=

# Directory for SQLite state files (default: .data; in container: /app/data)
AGENT_WALLET_DATA_DIR=

# Owner token for owner endpoints and the UI (unset: they answer 503). Use a throwaway value.
AGENT_WALLET_OWNER_TOKEN=

# Postgres backend (names only). Unset DATABASE_URL: the SQLite backend under AGENT_WALLET_DATA_DIR.
# Use the provider's pooler URL (Supabase: transaction mode, port 6543, ?sslmode=require).
DATABASE_URL=
# Optional DDL-capable role used by `python -m core.storage.migrate` (falls back to DATABASE_URL).
DATABASE_MIGRATE_URL=
# docker compose only: password of the bundled `db` service.
POSTGRES_PASSWORD=
# Tests only: a throwaway database for the Postgres contract suite. Never a real database.
TEST_DATABASE_URL=
