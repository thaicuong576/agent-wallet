# Copy to .env and fill in. Never commit .env. Testnet only, never a mainnet key.
OPENAI_API_KEY=
AGENT_WALLET_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
IPS_PATH=contracts/examples/ips.valid.json

# Directory for SQLite state files (default: .data; in container: /app/data)
AGENT_WALLET_DATA_DIR=

# Owner token for owner endpoints and the UI (unset: they answer 503). Use a throwaway value.
AGENT_WALLET_OWNER_TOKEN=
